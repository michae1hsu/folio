# Copy this file to .env. Fill values locally; never commit .env.
# Only this project's .env is loaded; process environment variables take precedence.
OPENAI_API_KEY=
# Optional direct credential override. Leave empty to use OPENAI_API_KEY.
FOLIO_OPENAI_DIRECT_KEY=

# Keep model choices explicit. Your API project must have access to these models.
DOCUMENT_MODEL=gpt-6-luna
TRANSCRIPTION_MODEL=gpt-transcribe
REPORT_MODEL=gpt-6-luna
AGENT_MODEL=gpt-6.1-sol

# TypeSafe JEV is needed only when selected for relevance grading or answer evaluation.
# OpenAI Decisions uses the OpenAI credential above and the fixed gpt-6-luna model.
JEV_API_KEY=
JEV_MODEL=jev-1.13.0

# Google credentials are a SEPARATE downloaded JSON file, preferably outside this repo.
# Set an absolute path, for example /home/me/.config/folio/service-account.json.
# On Windows, forward slashes work: C:/credentials/folio-service-account.json.
# Never paste JSON or a private key into this template.
GOOGLE_SERVICE_ACCOUNT_FILE=
# Private Cloud Storage bucket for generated Markdown (also used for ZIP libraries).
GCS_BUCKET=

# Empty uses embedded Qdrant in data/qdrant. Optional remote server configuration:
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=folio_text_v1

# Optional absolute directory for private runtime data; defaults to ./data.
# FOLIO_DATA_DIR=
